    "test:calculators": "node --experimental-strip-types --test src/modules/calculators/engine.test.ts",
    "test:calculator-units": "node --experimental-strip-types --test src/modules/calculators/unitConversion.test.ts",
    "test:calculator-validation": "node --experimental-strip-types --test src/services/calculatorValidation.test.ts",
    "test:calculator-integrity": "node --experimental-strip-types --test src/services/calculatorGuidelineIntegrity.test.ts src/services/calculatorMigrationPolicy.test.ts",
    "test:guideline-publication": "node --experimental-strip-types --test src/services/guidelinePublication.test.ts",
    "test:guideline-public": "node --experimental-strip-types --test src/services/guidelineCorePublicService.test.ts",
    "test:guideline-core": "node --experimental-strip-types --test src/services/guidelineValidation.test.ts src/services/guidelineLegacyMigrationService.test.ts src/services/guidelineCoreMigrationPolicy.test.ts src/services/guidelineSectionValidation.test.ts src/services/guidelineSprintC.test.ts",
    "test:calculator-reset": "node --experimental-strip-types --test src/services/calculatorReset.test.ts",
    "test:visibility": "node --experimental-strip-types --test src/utils/publicVisibility.test.ts",
    "test:knowledge-relationships": "node --experimental-strip-types --test src/services/knowledgeRelationship.test.ts src/services/lifecycleDestructiveActions.test.ts",
    "test:deep-links": "node --experimental-strip-types --test src/utils/recommendationDeepLink.test.ts",
    "test:theme": "node --experimental-strip-types --test src/theme/themePreference.test.ts",
    "test:brand": "node --experimental-strip-types --test src/components/branding/brandIntegration.test.ts",
    "test:ui": "node --experimental-strip-types --test src/components/uiPrimitives.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.3",
    "@tailwindcss/vite": "^4.3.2",
    "docx": "^9.7.1",
